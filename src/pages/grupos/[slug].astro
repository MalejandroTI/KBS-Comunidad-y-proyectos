---
import MainLayout from "../../layouts/MainLayout.astro";
import MemberCard from "../../components/memberCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const groups = await getCollection("groups");

  return groups.map((group) => ({
    params: { slug: group.id },
    props: { group },
  }));
}

const { group } = Astro.props;

const members = await getCollection("members");
const projects = await getCollection("projects");

const groupMembers = members.filter((member) =>
  (group.data.integrantes ?? []).some(
    (id) => id.trim().toLowerCase() === member.id.trim().toLowerCase()
  )
);

const heroPhoto = group.data.foto_grupal ?? group.data.foto;

const groupProjects = projects.filter((project) => group.data.proyectos.includes(project.id));
---

<MainLayout
  title={`${group.data.nombre} | KBS`}
  description={group.data.descripcion}
  active="conocenos"
>
  <main>
    <section class="page-hero">
      <div class="wrap">
        <a class="back-link" href="/#conocenos">← Volver a Conócenos</a>
        <div class="hero-grid">
          <div class="hero-text">
            <p class="eyebrow on-dark">Comunidad KBS · Grupos</p>
            <h1>{group.data.nombre}</h1>
            <p class="slogan">{group.data.slogan}</p>
            <p class="lead">{group.data.descripcion}</p>
          </div>

          {heroPhoto && (
            <img
              class="cover"
              src={heroPhoto}
              alt={`Fotografía del grupo ${group.data.nombre}`}
              onerror="this.style.display='none'"
            />
          )}
        </div>
      </div>
    </section>

    <div class="wrap body">
      <section class="block">
        <p class="eyebrow">El equipo</p>
        <h2>Integrantes</h2>
        {groupMembers.length > 0 ? (
          <div class="projects-grid members-grid">
            {groupMembers.map((member) => (
              <MemberCard
                nombre={member.data.nombre}
                correo={member.data.correo}
                foto={member.data.foto}
                href={`/integrantes/${member.id}/`}
              />
            ))}
          </div>
        ) : (
          <p class="empty-state">Próximamente conocerás a los integrantes de este grupo.</p>
        )}
      </section>

      <section class="block">
        <p class="eyebrow">Lo que hacemos</p>
        <h2>Proyectos</h2>

        {groupProjects.length > 0 ? (
          <div class="projects-list">
            {groupProjects.map((project) => (
              <a class="project-row" href={`/proyectos/${project.id}/`}>
                <div>
                  <h3>{project.data.title}</h3>
                  <p>{project.data.description}</p>
                </div>
                <span class="tag">{project.data.status}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty-state">Este grupo todavía no tiene proyectos publicados.</p>
        )}
      </section>

      <section class="contact">
        <div>
          <p class="eyebrow on-dark">Contacto</p>
          <h2>Hablemos</h2>
        </div>
        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${group.data.contacto.correo}`}>
            {group.data.contacto.correo}
          </a>
          <a class="btn btn-ghost" href={group.data.contacto.github} target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
        </div>
      </section>
    </div>
  </main>
</MainLayout>

<style>
  .wrap {
    width: min(1100px, calc(100% - 48px));
    margin-inline: auto;
  }

  .page-hero {
    padding: 36px 0 72px;
    background: var(--color-primary);
    color: var(--color-white);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 40px;
    color: rgb(255 255 255 / 80%);
    font-size: 0.85rem;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .on-dark {
    color: var(--color-white);
  }

  .page-hero h1 {
    margin-bottom: 12px;
    color: var(--color-white);
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    overflow-wrap: anywhere;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }

  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: #E9EDF3;
    box-shadow: 0 16px 40px rgb(0 0 0 / 30%);
  }

  .slogan {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    font-weight: 600;
  }

  .lead {
    max-width: 640px;
    color: rgb(255 255 255 / 85%);
  }

  .body {
    padding-block: 24px 80px;
  }

  .block {
    padding-block: 56px 8px;
  }

  .block h2 {
    margin-bottom: 28px;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  }

  .members-grid {
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 26px;
    border: 1px solid rgb(0 40 85 / 6%);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .project-row:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .project-row h3 {
    margin-bottom: 4px;
    font-size: 1.3rem;
  }

  .project-row p {
    max-width: 600px;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 64px;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
  }

  .contact h2 {
    margin: 0;
    color: var(--color-white);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .cover {
      max-width: 420px;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 700px) {
    .wrap {
      width: calc(100% - 32px);
    }

    .project-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact {
      padding: 28px 22px;
    }
  }
</style>