---
import { getCollection } from "astro:content";
import { withBase } from "../utils/paths";

interface Props {
  /** "overlay": transparente sobre el hero (inicio). "solid": azul marino en páginas internas. */
  variant?: "overlay" | "solid";
  /** Enlace activo: inicio | quienes-somos | proyectos | conocenos */
  active?: string;
}

const { variant = "solid", active = "" } = Astro.props;
const home = withBase("/");
const groups = await getCollection("groups");

const links = [
  { id: "inicio", label: "Inicio", href: `${home}#inicio` },
  {
    id: "quienes-somos",
    label: "Quiénes somos",
    href: `${home}#quienes-somos`,
  },
  {
    id: "proyectos",
    label: "Proyectos",
    href: `${home}#proyectos`,
  },
  {
    id: "conocenos",
    label: "Conócenos",
    href: `${home}#conocenos`,
    children: groups.map((g) => ({
      label: g.data.nombre,
      href: withBase(`grupos/${g.id}/`),
    })),
  },
];
---

<header class:list={["site-header", `is-${variant}`]} data-variant={variant}>
  <div class="nav-inner">
    <a class="brand" href={`${home}#inicio`} aria-label="KBS, inicio">
      <img
        class="brand-logo"
        src={withBase("/kbs.png")}
        alt="KBS - Sistemas Basados en el Conocimiento, Grupo de Investigación"
      />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Abrir menú"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" id="main-nav" aria-label="Navegación principal">
      <ul>
        {links.map((link) => (
          <li class:list={["nav-item", { "has-children": !!link.children?.length }]}>
            <a
              href={link.href}
              data-nav={link.id}
              class:list={[{ active: active === link.id }]}
              aria-current={active === link.id ? "page" : undefined}
            >
              {link.label}
              {link.children?.length ? (
                <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : null}
            </a>

            {link.children?.length ? (
              <ul class="dropdown">
                {link.children.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ul>
    </nav>

    <a class="nav-cta" href={`${home}#conocenos`}>Sé parte</a>
  </div>
</header>

<script>
  // Menú móvil
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const header = document.querySelector<HTMLElement>(".site-header");
  toggle?.addEventListener("click", () => {
    const open = header?.classList.toggle("menu-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  });
  document.querySelectorAll(".main-nav a").forEach((a) =>
    a.addEventListener("click", () => {
      header?.classList.remove("menu-open");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );

  // En la portada: resalta la sección visible y cambia a fondo sólido al bajar
  if (header?.dataset.variant === "overlay") {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 40);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const ids = ["inicio", "quienes-somos", "proyectos", "conocenos"];
    const setActive = (id: string) =>
      document.querySelectorAll<HTMLAnchorElement>(".main-nav a[data-nav]").forEach((a) => {
        const on = a.dataset.nav === id;
        a.classList.toggle("active", on);
        on ? a.setAttribute("aria-current", "page") : a.removeAttribute("aria-current");
      });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => e.isIntersecting && setActive(e.target.id));
      },
      { rootMargin: "-45% 0px -50% 0px" }
    );
    ids.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
    setActive("inicio");
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 100;
    width: 100%;
    background: var(--color-primary);
    color: var(--color-white);
    transition: background var(--transition), box-shadow var(--transition);
  }

  .site-header.is-overlay {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
  }

  .site-header.is-overlay.scrolled,
  .site-header.is-overlay.menu-open {
    background: var(--color-primary);
    box-shadow: 0 6px 24px rgb(0 20 43 / 25%);
  }

  .site-header.is-solid {
    position: sticky;
    top: 0;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    width: min(var(--container-width), calc(100% - 48px));
    min-height: var(--header-height);
    margin-inline: auto;
  }

  /* Logotipo */
  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1;
    color: var(--color-white);
  }

  .brand-mark {
    font-family: var(--font-heading);
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .brand-dot {
    color: var(--color-accent);
  }

  .brand-tag {
    margin-top: 4px;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  /* Menú central */
  .main-nav ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .main-nav a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: var(--radius-pill);
    color: var(--color-white);
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background var(--transition), color var(--transition);
  }

  .main-nav a:hover,
  .main-nav a.active {
    background: var(--color-accent);
    color: var(--color-primary);
  }

  .chevron {
    transition: transform var(--transition);
  }

  .has-children:hover .chevron,
  .has-children:focus-within .chevron {
    transform: rotate(180deg);
  }

  /* Desplegable */
  .dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    display: block !important;
    min-width: 220px;
    padding: 8px !important;
    border-radius: 16px;
    background: var(--color-white);
    box-shadow: var(--shadow-hover);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }

  .has-children::after {
    /* puente para que el hover no se pierda entre enlace y menú */
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 8px;
    content: "";
  }

  .has-children:hover .dropdown,
  .has-children:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown a {
    display: flex;
    width: 100%;
    border-radius: 10px;
    color: var(--color-primary);
    font-weight: 500;
  }

  .dropdown a:hover {
    background: var(--color-background);
    color: var(--color-primary);
  }

  /* CTA */
  .nav-cta {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 9px 22px;
    border: 1.5px solid rgb(255 255 255 / 85%);
    border-radius: var(--radius-pill);
    color: var(--color-white);
    font-size: 0.84rem;
    font-weight: 600;
    transition: background var(--transition), color var(--transition);
  }

  .nav-cta:hover {
    background: var(--color-white);
    color: var(--color-primary);
  }

  .nav-toggle {
    display: none;
  }

  /* Móvil */
  @media (max-width: 960px) {
    .nav-inner {
      grid-template-columns: 1fr auto auto;
      gap: 12px;
    }

    .nav-toggle {
      display: grid;
      width: 44px;
      height: 44px;
      place-content: center;
      gap: 5px;
      border: 1.5px solid rgb(255 255 255 / 70%);
      border-radius: 50%;
      background: transparent;
    }

    .nav-toggle span {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: var(--color-white);
    }

    .nav-cta {
      display: none;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      padding: 8px 24px 24px;
      background: var(--color-primary);
    }

    .menu-open .main-nav {
      display: block;
    }

    .main-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .main-nav a {
      width: 100%;
    }

    .dropdown {
      position: static;
      min-width: 0;
      padding: 0 0 0 14px !important;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .dropdown a {
      color: rgb(255 255 255 / 85%);
      font-size: 0.8rem;
    }

    .dropdown a:hover {
      background: var(--color-accent);
      color: var(--color-primary);
    }

    .has-children::after,
    .chevron {
      display: none;
    }
  }

.brand {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand-logo {
  display: block;
  width: 220px;
  height: auto;
  object-fit: contain;
  padding: 8px 0;
}
</style>
