---
const base = import.meta.env.BASE_URL;

---

<section class="about" id="quienes-somos">
  <div class="about-inner">
    <div class="about-copy">
      <p class="eyebrow">Sobre KBS</p>
      <h2>Somos un grupo de docentes y estudiantes apasionados por los datos.</h2>

      <p class="description">
      Desarrollamos herramientas tecnológicas y de software que simplifican la exploración, y análisis de información, 
      impulsando la investigación académica y la toma de decisiones.
      </p>

      <a class="btn btn-secondary" href={`${base}#conocenos`}>
  Conoce al grupo <span aria-hidden="true">→</span>
</a>
    </div>

    <div class="about-image" role="img" aria-label="Espacio reservado para una fotografía del grupo KBS">
            <img
        src={`${base}images/about/grupo.jpg`}
        alt=""
        loading="lazy"
        onerror="this.remove()"
      />
      <div class="placeholder">
        <span>Imagen del grupo</span>
        <small>Reemplazar por una fotografía en /public/images/about/grupo.jpg</small>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(64px, 9vw, 112px);
    background: var(--color-surface);
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
    width: min(var(--container-width), calc(100% - 48px));
    margin-inline: auto;
  }

  h2 {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
  }

  .description {
    max-width: 460px;
    margin-bottom: 28px;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .about-image {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #E9EDF3, #d5deea);
    box-shadow: var(--shadow-card);
  }

  .about-image img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 24px;
    color: var(--color-primary);
    text-align: center;
  }

  .placeholder span {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
  }

  .placeholder small {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 760px) {
    .about-inner {
      grid-template-columns: 1fr;
      width: calc(100% - 32px);
    }

    .about-image {
      min-height: 260px;
    }
  }
</style>
