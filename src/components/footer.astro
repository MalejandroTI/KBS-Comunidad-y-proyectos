---
import { withBase } from "../utils/paths";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-brand">
      <strong>KBS<span>.</span></strong>
      <p>Comunidad académica y tecnológica.</p>
    </div>

    <nav class="footer-links" aria-label="Pie de página">
      <a href={withBase("#inicio")}>Inicio</a>
      <a href={withBase("#quienes-somos")}>Quiénes somos</a>
      <a href={withBase("#proyectos")}>Proyectos</a>
      <a href={withBase("#conocenos")}>Conócenos</a>
    </nav>
  </div>

  <div class="footer-bottom">KBS · Período académico {year}</div>
</footer>

<style>
  .footer-brand strong {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 2rem;
    letter-spacing: -0.06em;
  }

  .footer-brand strong span {
    color: var(--color-accent);
  }

  .footer-brand p {
    margin: 4px 0 0;
    color: rgb(255 255 255 / 75%);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
</style>
